# Deriv
DERIV_APP_ID=1089
DERIV_API_TOKEN=your_token_here
DERIV_ACCOUNT_TYPE=real
# DERIV_ACCOUNT_ID=CR900123   # optional -- set to skip the accounts lookup call

# Supabase (optional -- bot logs to stdout regardless)
SUPABASE_URL=
SUPABASE_KEY=

# Trading
STAKE_AMOUNT=1.0
MIN_PAYOUT_PCT=52.0
MAX_CONCURRENT_TRADES=1
COOLDOWN_SEC_AFTER_TRADE=30

# Monte Carlo
MC_PATHS=5000
HMM_N_STATES=3
JUMP_INTENSITY_PER_DAY=2.0
JUMP_MEAN=0.0
JUMP_STD=0.004
TICKS_PER_SECOND=1.0

# Data windows
PRICE_HISTORY_LEN=3000
REFIT_INTERVAL_SEC=900
MIN_TICKS_BEFORE_TRADING=600

# Compression regime thresholds
COMPRESSION_VOL_PERCENTILE=35
COMPRESSION_BBW_PERCENTILE=35
COMPRESSION_ADX_MAX=20
COMPRESSION_HURST_MAX=0.48
REGIME_LOOKBACK=300
